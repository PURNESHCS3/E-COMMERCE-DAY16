# Copy to .env.deploy and replace the placeholder secrets before starting.
POSTGRES_DB=shophub
POSTGRES_USER=shophub
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
APP_ORIGIN=http://localhost:8080
HTTP_PORT=8080

# Optional AI providers. Keep keys in this untracked environment file only.
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.8-flash
AI_DAILY_PROVIDER_CALL_LIMIT=100
AI_DAILY_ESTIMATED_TOKEN_LIMIT=300000
AI_MAX_COMPLETION_TOKENS=2048
AI_RESPONSE_CACHE_TTL_SECONDS=3600
